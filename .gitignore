# Google Cloud service account keys: these contain a private key.
# The downloaded filename is <project>-<hash>.json, which matches nothing
# else here, but the broader patterns catch a renamed copy too.
gen-lang-client-*.json
*service*account*.json
*-key.json

# Audio never belongs here (AGENTS.md: no recordings or audio fixtures), and
# the test scripts produce it. One slipped into history once via git add -A.
*.wav
*.pcm
*.mp3
